# ══════════════════════════════════════════════════════════════
# NexMeet — root environment template (copy to .env)
# Consumed by docker-compose.yml and the server container.
# Local Docker only: every hostname below is a compose service name
# on the internal `NexMeet` network, NOT localhost.
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Comma-separated CORS allowlist. Every origin a browser will actually use
# must appear here, including your LAN address if you open the app from a
# phone or another laptop on the same Wi-Fi. The frontend container serves
# both http://localhost:80 and https://localhost:443 (self-signed certs
# in ./certs), so both origins are listed here.
CLIENT_URL=https://localhost,http://localhost

# ── LAN access (optional — leave empty for localhost-only) ───
# Your host's IPv4 address on the local network. Windows: `ipconfig`.
# Set this ONLY if you want to reach the app from other devices on the
# same Wi-Fi, and do all three of these:
#
#   1. LAN_IP=192.168.1.10
#   2. Add http(s)://192.168.1.10 to CLIENT_URL above.
#   3. Regenerate ./certs so the certificate covers that IP:
#        openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#          -keyout certs/privkey.pem -out certs/fullchain.pem \
#          -subj "/CN=NexMeet local dev" \
#          -addext "subjectAltName=DNS:localhost,IP:127.0.0.1,IP:192.168.1.10"
#      then: docker compose up -d --force-recreate livekit backend
#
# LAN_IP is passed to LiveKit as --node-ip so the SFU advertises an address
# other devices can actually reach. Without it LiveKit advertises its
# container IP (e.g. 172.19.0.5): signaling works, but media does not.
# Leaving it empty makes LiveKit auto-detect, which is correct for
# localhost-only use.
LAN_IP=


# ── Auth (signing key for app-level JWTs) ───────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── LiveKit ─────────────────────────────────────────────────
# Injected into the SFU via LIVEKIT_KEYS. Both values below are
# local-only dev credentials — never reuse them anywhere public.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Server-side informational URL only. Browsers connect through the
# same-origin /livekit proxy that nginx exposes on 443, so this value
# is never dialled by the client.
LIVEKIT_WS_URL=ws://livekit:7880

# ── TURN (must match turnserver.conf static-auth-secret) ────
TURN_DOMAIN=localhost
TURN_SECRET=change-me-turn-secret

# ── Data stores ─────────────────────────────────────────────
# Postgres and Redis are NOT published to the host — reach them by
# service name over the compose network. POSTGRES_USER must match
# the user in DATABASE_URL; Postgres role names are case-sensitive.
POSTGRES_USER=NexMeet
POSTGRES_DB=nexmeet
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://NexMeet:change-me-postgres-password@postgres:5432/nexmeet?sslmode=disable
REDIS_URL=redis://redis:6379

# Always "false" for the Docker stack — compose supplies a real
# Postgres + Redis. Only set true when running the server directly
# on the host with no containers (see server/.env.example).
IN_MEMORY_STORE=false
