# ══════════════════════════════════════════════════════════════
# NexMeet — root environment template (copy to .env)
# Consumed by docker-compose.yml and the server container.
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Comma-separated list of allowed CORS origins
CLIENT_URL=http://localhost:5173

# ── Auth (signing key for app-level JWTs) ───────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── LiveKit ─────────────────────────────────────────────────
# Must match the `keys` section of livekit.yaml.
# For LiveKit Cloud, copy these from your project settings.
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Server-side SFU URL (shown at startup, used for token minting context).
# Browsers connect via the same-origin /livekit proxy (Vite dev / Nginx);
# set VITE_LIVEKIT_WS_URL on the CLIENT to override (e.g. LiveKit Cloud:
# wss://your-project.livekit.cloud).
LIVEKIT_WS_URL=ws://localhost:7880

# ── TURN (must match turnserver.conf static-auth-secret) ────
TURN_DOMAIN=localhost
TURN_SECRET=change-me-turn-secret

# ── Data stores ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexmeet
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexmeet
REDIS_URL=redis://localhost:6379

# Set "true" to run WITHOUT Postgres/Redis (in-memory dev/demo mode).
# docker-compose always overrides this to "false" for the stack.
IN_MEMORY_STORE=true
