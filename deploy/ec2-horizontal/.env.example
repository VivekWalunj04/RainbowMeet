# ══════════════════════════════════════════════════════════════
# NexMeet Horizontal EC2 Deployment (backend replicas + LB)
# ══════════════════════════════════════════════════════════════

# Domain pointing at this EC2 instance's public IP (used by Caddy for auto-TLS)
API_DOMAIN=api.yourdomain.com

# LiveKit SFU domain (runs on its OWN EC2 via deploy/ec2-sfu/)
SFU_DOMAIN=sfu.yourdomain.com

# Vercel Frontend origin (comma-separated if multiple domains)
CLIENT_URL=https://nexmeet.vercel.app

# Secret for signing NexMeet app session JWTs (generate: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# LiveKit SFU credentials (MUST match the SFU EC2 .env)
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Managed Neon PostgreSQL Connection String (pooled, ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/nexmeet?sslmode=require

# Redis is provisioned by this compose file on the internal network
# (redis://redis:6379) — do not override here. It carries the Socket.IO
# adapter, global presence, chat history and the Lamport clock, so every
# backend replica shares one consistent state.