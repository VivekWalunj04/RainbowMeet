# ══════════════════════════════════════════════════════════════
# NexMeet EC2 Backend Environment Configuration
# ══════════════════════════════════════════════════════════════

# Domain pointing to this EC2 instance's public IP (used by Caddy for auto-TLS)
API_DOMAIN=api.yourdomain.com

# Vercel Frontend origin (comma-separated if multiple domains)
CLIENT_URL=https://nexmeet.vercel.app

# Secret for signing NexMeet app session JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# LiveKit SFU credentials (MUST match credentials configured on SFU EC2 instance)
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_WS_URL=wss://sfu.yourdomain.com

# Neon PostgreSQL Connection String (pooled connection string)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/nexmeet?sslmode=require

# Upstash Redis Connection String (TLS enabled)
REDIS_URL=rediss://default:password@xxx.upstash.io:6379
