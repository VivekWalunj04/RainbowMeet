# ══════════════════════════════════════════════════════════════
# NexMeet SFU (EC2) — copy to .env on the instance
# ══════════════════════════════════════════════════════════════

# Domain pointing at this EC2 instance's public IP (A record).
# Caddy uses it for Let's Encrypt; clients connect to wss://$SFU_DOMAIN
SFU_DOMAIN=sfu.yourdomain.com

# Generate a strong keypair once, e.g.:
#   key:  API$(tr -dc A-Za-z0-9 </dev/urandom | head -c16)
#   secret: $(openssl rand -hex 32)
# The SAME values must be set on the backend (Render/AWS):
#   LIVEKIT_API_KEY / LIVEKIT_API_SECRET
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-64-hex-chars
