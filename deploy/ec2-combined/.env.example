# ══════════════════════════════════════════════════════════════
# NexMeet Combined Single-EC2 Environment Configuration
# ══════════════════════════════════════════════════════════════

# Domains (both A records must point to this EC2 public IP)
API_DOMAIN=api.yourdomain.com
SFU_DOMAIN=sfu.yourdomain.com

# Vercel Frontend URL
CLIENT_URL=https://nexmeet.vercel.app

# JWT Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# LiveKit Credentials
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Managed Neon PostgreSQL & Upstash Redis
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/nexmeet?sslmode=require
REDIS_URL=rediss://default:password@xxx.upstash.io:6379
