# ══════════════════════════════════════════════════════════════
# nexmeet server environment (copy to .env)
# Covers: local dev (in-memory) and split-origin production
# ══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ── CORS allowlist (comma-separated origins) ─────────────────
# Local dev:
CLIENT_URL=http://localhost:5173
# Production (Vercel + custom domains):
# CLIENT_URL=https://nexmeet.vercel.app,https://meet.example.com

# ── Auth ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me

# ── LiveKit SFU ──────────────────────────────────────────────
# Local dev (--dev mode SFU uses devkey/secret):
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WS_URL=ws://localhost:7880
# Production — must match deploy/ec2-sfu/.env keypair; browser-facing TLS URL:
# LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
# LIVEKIT_API_SECRET=<64-hex>
# LIVEKIT_WS_URL=wss://sfu.yourdomain.com

# ── Data stores ──────────────────────────────────────────────
# Local dev — run without Postgres/Redis entirely:
IN_MEMORY_STORE=true
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexmeet?sslmode=disable
# REDIS_URL=redis://localhost:6379
#
# Production — Neon (pooled connection, note sslmode=require):
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/nexmeet?sslmode=require
# Production — Upstash (TLS):
# REDIS_URL=rediss://default:<token>@xxx.upstash.io:6379
#
# IN_MEMORY_STORE=true takes precedence and skips both stores.
