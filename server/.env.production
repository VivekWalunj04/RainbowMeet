# ============================================================
# nexmeet Production Environment (Zero-Cost Stack)
# ============================================================
# Deploy to: Render (backend), Vercel (frontend), AWS EC2 (LiveKit)
# Database: Neon PostgreSQL (free tier)
# Cache/PubSub: Upstash Redis (free tier)
#
# NOTE: these values are configured in each provider's dashboard,
# NOT as files on the server. This template documents what goes where.
# See DEPLOY.md for the full walkthrough.
# ============================================================

# ------------------------------------------------------------------
# Render dashboard → nexmeet-server → Environment
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# CORS: your Vercel origin(s). Add custom domains when you have them.
CLIENT_URL=https://nexmeet.vercel.app

# Generate: openssl rand -hex 32  (or let render.yaml generate it)
JWT_SECRET=CHANGE_ME

# LiveKit — must match deploy/ec2-sfu/.env keypair exactly.
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

# Browser-facing SFU URL (Caddy TLS on EC2):
LIVEKIT_WS_URL=wss://sfu.yourdomain.com

# Neon PostgreSQL — pooled connection string from Neon dashboard.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/nexmeet?sslmode=require

# Upstash Redis — TLS connection string from Upstash console.
REDIS_URL=rediss://default:token@xxx.upstash.io:6379

# ------------------------------------------------------------------
# Vercel dashboard → project → Settings → Environment Variables
# (build-time, baked into the client bundle)
# ------------------------------------------------------------------
# VITE_API_URL=https://nexmeet-server.onrender.com
# VITE_SOCKET_URL=wss://nexmeet-server.onrender.com
# VITE_LIVEKIT_WS_URL=wss://sfu.yourdomain.com

# ------------------------------------------------------------------
# Rate limits / token TTLs are hardcoded in the server (see
# src/config/index.ts and route files) and are intentionally NOT
# configurable via env vars. Adjust in code if needed.
# ------------------------------------------------------------------
