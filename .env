# ══════════════════════════════════════════════════════════════
# NexMeet — production environment (docker-compose)
# All secrets below are freshly generated. Rotate if leaked.
# ══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Comma-separated CORS allowlist. Replace with your real origin(s) on deploy,
# e.g. https://meet.example.com (keep localhost entries only for testing).
CLIENT_URL=https://localhost,http://localhost

# ── Auth (signing key for app-level JWTs) ───────────────────
JWT_SECRET=c91ed62c104a8c20c385b9c33a0e9318cbd12958bdb41efa26fb587c832dca77

# ── LiveKit ─────────────────────────────────────────────────
# Injected into the SFU via LIVEKIT_KEYS and used by the server to mint tokens.
LIVEKIT_API_KEY=APIMbjQN6KppMGFF9Yv
LIVEKIT_API_SECRET=e3621d113eec38376afd206b9d513f37af10a4bb31db41d907bc19be701aa0fb
# Server-side informational URL only — browsers always connect through the
# same-origin /livekit proxy. Do NOT set VITE_LIVEKIT_WS_URL unless split-origin.
LIVEKIT_WS_URL=ws://livekit:7880

# ── TURN (must match turnserver.conf static-auth-secret) ────
TURN_DOMAIN=localhost
TURN_SECRET=3a76fb1299f56175245046705385e2ac4d18a257f2739f45

# ── Data stores (internal compose network only) ─────────────
POSTGRES_PASSWORD=eV8ub4Cb2Prvt2cPqZyc
DATABASE_URL=postgres://NexMeet:eV8ub4Cb2Prvt2cPqZyc@postgres:5432/nexmeet?sslmode=disable
REDIS_URL=redis://redis:6379

# NOTE: no VITE_API_URL / VITE_SOCKET_URL here on purpose — the client is built
# with same-origin defaults so nginx proxies /api, /socket.io and /livekit.
